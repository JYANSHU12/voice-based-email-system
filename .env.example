# Voice-Based Email System Configuration
# Rename or copy this file to .env and adjust variables as needed

# Flask Backend Server Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True

# Email Server Defaults (Gmail SMTP / IMAP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
